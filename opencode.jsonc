{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // AGENCIA GENERADORA — agencia de empleados virtuales IA
  // El usuario interactúa SOLO con el agente "director" (primary).
  // La carta de la agencia (contexto, límites, etc.) vive en
  // constitucion/ y se crea al constituir la agencia (/constitucion).
  // ============================================================

  "default_agent": "director",

  // ── Modelos: DeepSeek (API ya configurada en opencode) ──────
  // Otros proveedores se añaden directo vía "provider" o /connect,
  // sin gateway intermedio.
  "model": "deepseek/deepseek-v4-pro",         // director, empleado, revisor, reclutador (heredan)
  "small_model": "deepseek/deepseek-v4-flash", // títulos, resúmenes, compaction

  // ── Eficiencia de contexto ──────────────────────────────────
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },

  // ── Permisos globales ───────────────────────────────────────
  // El conocimiento de la agencia se actualiza automáticamente;
  // el resto (incluida la config) requiere aprobación.
  "permission": {
    "edit": {
      "*": "ask",
      "**/memoria/**": "allow",
      "**/plantilla/**": "allow",
      "**/salida/**": "allow",
      "**/constitucion/**": "allow",
      "**/constitucion/directrices.md": "deny",
      "**/skills/**": "allow",
      "**/AGENTS.md": "allow"
    },
    "bash": {
      "*": "ask",
      "git*": "allow",
      "git push*": "ask"
    }
  }
}
